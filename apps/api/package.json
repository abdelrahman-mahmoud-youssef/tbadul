{
  "name": "@engagement-exchange/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && pnpm run \"/^dev:/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "e2e:serve": "node dist-e2e/testing/e2e-server.js"
  },
  "dependencies": {
    "@engagement-exchange/contracts": "workspace:*",
    "@engagement-exchange/db": "workspace:*",
    "@engagement-exchange/social-accounts": "workspace:*",
    "@engagement-exchange/verification": "workspace:*",
    "@fastify/rate-limit": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "better-auth": "catalog:",
    "fastify": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
