{
  "name": "@engagement-exchange/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/database": {
      "types": "./dist/testing/test-database.d.ts",
      "default": "./dist/testing/test-database.js"
    },
    "./testing/global-setup": {
      "types": "./dist/testing/global-setup.d.ts",
      "default": "./dist/testing/global-setup.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.live.test.ts\"",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config auth.config.ts --adapter drizzle --dialect postgresql --output src/schema/auth.ts --yes && prettier --write src/schema/auth.ts"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/pg": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
