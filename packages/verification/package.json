{
  "name": "@engagement-exchange/verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.live.test.ts\"",
    "test:live": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run --passWithNoTests .live.test."
  },
  "dependencies": {
    "cockatiel": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:"
  }
}
